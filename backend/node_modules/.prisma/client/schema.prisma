// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  name              String
  password          String
  avatar_path       String?
  email_verified_at DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // Relations
  comments  Comment[]
  read_list ReadList[]
  follows   Follow[]
  roles     UserRole[]

  @@map("users")
}

model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  display_name String
  created_at   DateTime @default(now())

  // Relations
  users UserRole[]

  @@map("roles")
}

model UserRole {
  id      Int @id @default(autoincrement())
  user_id Int
  role_id Int

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model Comment {
  id               Int      @id @default(autoincrement())
  content          String
  user_id          Int
  commentable_type String // "series" | "chapter"
  commentable_id   String // MangaDex UUID
  parent_id        Int? // For replies
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relations
  user    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parent_id], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

model ReadList {
  id         Int      @id @default(autoincrement())
  user_id    Int
  series_id  String // MangaDex UUID
  chapter_id String? // MangaDex UUID
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, series_id])
  @@map("read_list")
}

model Follow {
  id         Int      @id @default(autoincrement())
  user_id    Int
  series_id  String // MangaDex UUID
  created_at DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, series_id])
  @@map("follows")
}

model Settings {
  id               Int      @id @default(autoincrement())
  site_name        String   @default("MangaReader")
  site_description String   @default("Your ultimate manga reading experience")
  site_url         String   @default("https://mangareader.com")
  admin_email      String   @default("admin@mangareader.com")
  timezone         String   @default("UTC")
  language         String   @default("en")
  primary_color    String   @default("#3B82F6")
  logo_url         String   @default("/logo.png")
  favicon_url      String   @default("/favicon.ico")
  footer_logo_url  String   @default("/images/logo-footer.png")
  enable_dark_mode Boolean  @default(true)
  header_scripts   String   @default("")
  footer_scripts   String   @default("")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("settings")
}
